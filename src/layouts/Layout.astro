---
import type { Lang, Dict } from '../i18n/translations';
import { SITE_URL } from '../site';
import Navbar from '../components/Navbar.astro';
import Invite from '../components/Invite.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { lang: Lang; t: Dict; }
const { lang, t } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const canonical = lang === 'en' ? `${SITE_URL}/en/` : `${SITE_URL}/`;
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';
const ogLocaleAlt = lang === 'en' ? 'es_ES' : 'en_US';
const keywords =
  lang === 'es'
    ? 'loremaster, worldbuilding, RAG, IA generativa, escritores, juegos de rol, FastAPI, Qdrant, Ollama, ComfyUI, construcción de mundos'
    : 'loremaster, worldbuilding, RAG, generative AI, writers, TTRPG, FastAPI, Qdrant, Ollama, ComfyUI';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'LoreMaster',
  url: SITE_URL,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any (Web)',
  inLanguage: ['es', 'en'],
  description: t.meta.description,
  author: { '@type': 'Person', name: 'Sergio González', url: 'https://github.com/sergiogonzalezch' },
  sameAs: ['https://github.com/sergiogonzalezch/loremaster'],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Sergio González" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#07070e" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={`${SITE_URL}/`} />
  <link rel="alternate" hreflang="en" href={`${SITE_URL}/en/`} />
  <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LoreMaster" />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ogLocaleAlt} />
  <meta property="og:image" content={`${SITE_URL}/og.svg`} />
  <meta property="og:image:alt" content="LoreMaster — Tu mundo, con memoria" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={t.meta.title} />
  <meta name="twitter:description" content={t.meta.description} />
  <meta name="twitter:image" content={`${SITE_URL}/og.svg`} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline define:vars={{ lang, other }}>
    try {
      const stored = localStorage.getItem('lm-lang');
      if (stored && stored !== lang && (stored === 'es' || stored === 'en')) {
        const target = stored === 'en' ? 'en/' : '../';
        const here = location.pathname.endsWith('/en/') || location.pathname.endsWith('/en') ? 'en' : 'es';
        if (stored !== here) location.href = target;
      }
    } catch {}
  </script>
</head>
<body>
  <Navbar lang={lang} t={t} />
  <main>
    <slot />
    <Invite t={t} />
  </main>
  <Footer lang={lang} t={t} />
  <script is:inline>
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    const watch = () => document.querySelectorAll('.reveal:not(.visible)').forEach((el) => io.observe(el));
    watch();
    new MutationObserver(watch).observe(document.body, { childList: true, subtree: true });
  </script>
</body>
</html>
