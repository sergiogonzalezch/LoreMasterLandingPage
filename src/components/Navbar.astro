---
import type { Lang, Dict } from '../i18n/translations';
import { GITHUB_URL } from '../site';

interface Props { lang: Lang; t: Dict; }
const { lang, t } = Astro.props;

const esHref = lang === 'es' ? './' : '../';
const enHref = lang === 'es' ? 'en/' : './';

// Solo secciones directas. Los tabs viven dentro de cada seccion.
const links = [
  { href: '#producto', label: t.nav.groups.product },
  { href: '#arquitectura', label: t.nav.groups.tech },
  { href: '#proyecto', label: t.nav.groups.project },
  { href: '#faq', label: t.nav.faq },
];
---
<header class="lm-nav" id="siteNav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label="LoreMaster — top">
      <span class="glyph" aria-hidden="true">◈</span><span>Lore<em>Master</em></span>
    </a>

    <nav class="links" id="navLinks" aria-label="Sections">
      {links.map((l) => (
        <a class="nav-link" href={l.href} data-section={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="actions">
      <div class="lang" role="group" aria-label="Language / Idioma">
        <a href={esHref} class={lang === 'es' ? 'active' : ''} data-lang="es">ES</a>
        <a href={enHref} class={lang === 'en' ? 'active' : ''} data-lang="en">EN</a>
      </div>
      <a class="btn btn-outline btn-sm nav-github" href={GITHUB_URL} target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        GitHub
      </a>
      <a class="btn btn-primary btn-sm" href="#invite">✦ {t.nav.invite}</a>
    </div>

    <button class="toggle" id="navToggle" aria-label="Menu" aria-expanded="false">☰</button>
  </div>
</header>

<script is:inline>
  (() => {
    const links = document.getElementById('navLinks');
    const toggle = document.getElementById('navToggle');
    toggle?.addEventListener('click', () => {
      const open = links?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!!open));
    });
    links?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        links.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      })
    );
    document.querySelectorAll('.lang a').forEach((a) =>
      a.addEventListener('click', () => {
        try { localStorage.setItem('lm-lang', a.getAttribute('data-lang') || 'es'); } catch {}
      })
    );
    // Scrollspy: resalta la seccion visible
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = '#' + e.target.id;
        document.querySelectorAll('#navLinks .active-spy').forEach((x) => x.classList.remove('active-spy'));
        document.querySelector(`#navLinks a[data-section="${id}"]`)?.classList.add('active-spy');
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    ['producto', 'arquitectura', 'proyecto', 'faq', 'invite'].forEach((id) => {
      const s = document.getElementById(id);
      if (s) spy.observe(s);
    });
    // Sombra al hacer scroll
    const nav = document.getElementById('siteNav');
    addEventListener('scroll', () => nav?.classList.toggle('scrolled', scrollY > 8), { passive: true });
  })();
</script>

<style>
  .lm-nav {
    position: sticky; top: 0; z-index: 100; height: 64px;
    background: rgba(7, 7, 14, 0.82);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--lm-border);
    transition: box-shadow 0.25s ease;
  }
  .lm-nav.scrolled { box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5); }
  .lm-nav::after {
    content: ""; position: absolute; bottom: -1px; left: 50%;
    transform: translateX(-50%); width: 200px; height: 1px; opacity: 0.6;
    background: linear-gradient(90deg, transparent, var(--lm-accent), transparent);
  }
  .nav-inner { display: flex; align-items: center; gap: 18px; height: 64px; }
  .brand {
    display: flex; align-items: center; gap: 0.5rem; text-decoration: none;
    font-family: var(--lm-font-head); font-size: 1.08rem; font-weight: 700; color: var(--lm-text);
    flex-shrink: 0;
  }
  .brand em {
    font-style: normal;
    background: linear-gradient(120deg, var(--lm-accent), var(--lm-gold-light));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .glyph { color: var(--lm-accent); opacity: 0.8; animation: lm-glyph-pulse 3s ease-in-out infinite; }

  /* Links directos a secciones — sin dropdowns */
  .links {
    display: flex; align-items: center; gap: 2px; margin-left: 8px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--lm-border);
    border-radius: 999px; padding: 4px;
  }
  .nav-link {
    position: relative;
    display: inline-flex; align-items: center;
    color: var(--lm-text-muted); text-decoration: none;
    font-size: 0.87rem; font-weight: 500;
    padding: 7px 14px; border-radius: 999px;
    transition: color 0.18s, background 0.18s;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--lm-text); background: rgba(255, 255, 255, 0.05); }
  .nav-link.active-spy { color: var(--lm-gold-light); background: var(--lm-accent-glow); }

  .actions { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .btn-sm { font-size: 0.7rem; padding: 0.42rem 0.9rem; }
  .lang {
    display: flex; border: 1px solid var(--lm-border); border-radius: 999px;
    overflow: hidden; background: var(--lm-raised); padding: 2px;
  }
  .lang a {
    padding: 0.3rem 0.7rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em;
    color: var(--lm-text-muted); text-decoration: none; border-radius: 999px; transition: all 0.2s;
  }
  .lang a.active { background: var(--lm-accent); color: #09090f; }
  .toggle {
    display: none; background: none; border: 1px solid var(--lm-border);
    color: var(--lm-text); border-radius: 8px; padding: 5px 11px;
    font-size: 1.05rem; cursor: pointer;
  }

  /* Anclas con offset para el header fijo */
  :global(section[id]) { scroll-margin-top: 76px; }

  @media (max-width: 1080px) {
    .nav-github { display: none; }
  }
  @media (max-width: 900px) {
    .links {
      position: fixed; top: 64px; left: 12px; right: 12px;
      flex-direction: column; align-items: stretch;
      background: #0c0a18; border: 1px solid var(--lm-border-accent);
      border-radius: 14px; padding: 8px;
      display: none; box-shadow: var(--lm-shadow);
      margin-left: 0;
    }
    .links.open { display: flex; }
    .nav-link { width: 100%; font-size: 0.95rem; padding: 11px 14px; }
    .toggle { display: block; margin-left: auto; }
    .actions { margin-left: 0; }
    .actions .btn-outline { display: none; }
  }
</style>
