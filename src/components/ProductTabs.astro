---
import type { Dict } from '../i18n/translations';
interface Props { t: Dict; }
const { t } = Astro.props;
const h = t.productTabs;
const f = t.features;
const w = t.workflow;
const d = t.demoWidget;
---
<section class="section wrap" id="producto">
  <p class="kicker reveal">{h.kicker}</p>
  <h2 class="reveal">{h.titleA} <span class="hl">{h.titleB}</span></h2>

  <div class="tabbar reveal" role="tablist" aria-label={h.kicker} data-tabs="producto">
    <button class="tab-btn" role="tab" aria-selected="true" data-pane="features">⚙️ {t.nav.features}</button>
    <button class="tab-btn" role="tab" aria-selected="false" data-pane="workflow">🧭 {t.nav.workflow}</button>
    <button class="tab-btn" role="tab" aria-selected="false" data-pane="demo">✨ {t.nav.demo}</button>
  </div>

  <div class="tab-pane active" role="tabpanel" data-pane="features">
    <p class="lede">{f.lede}</p>
    <div class="grid">
      {f.cards.map((c) => (
        <article class="lm-card hoverable card">
          <div class="icon">{c.icon}</div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="tab-pane" role="tabpanel" data-pane="workflow">
    <div class="steps">
      {w.steps.map((s) => (
        <div class="lm-card step">
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <code class="inline">{s.code}</code>
        </div>
      ))}
    </div>
    <div class="term lm-card">
      <p class="term-t">{w.terminalTitle}</p>
      <pre>{w.terminal.join('\n')}</pre>
    </div>
  </div>

  <div class="tab-pane" role="tabpanel" data-pane="demo">
    <p class="lede">{d.sub}</p>
    <div class="mock lm-card" id="ragMock" data-scenarios={JSON.stringify(d.scenarios)} data-thinking={d.thinking} data-sources-label={d.sources}>
      <div class="bar"><span></span><span></span><span></span><em>{d.window}</em></div>
      <div class="body">
        <aside class="side">
          <p class="side-t">{d.collections}</p>
          <div class="cols" id="ragCols">
            {d.scenarios.map((s, i) => (
              <button class={i === 0 ? 'col active' : 'col'} data-i={i}>📜 {s.collection}</button>
            ))}
          </div>
          <p class="side-t">{d.entities}</p>
          <div class="chips"><span>Kael</span><span>Mira</span><span>Varenn</span><span>+125</span></div>
        </aside>
        <div class="stage">
          <div class="q" id="ragQ">“{d.scenarios[0].question}”</div>
          <button class="btn btn-primary btn-sm" id="ragAsk">{d.ask} ▸</button>
          <div class="a" id="ragA" hidden>
            <b>LoreMaster ·</b> <span id="ragAText"></span>
            <div class="srcs" id="ragSrcs"></div>
          </div>
          <div class="gen" id="ragGen" hidden>
            <span class="gen-t">🎨 <span id="ragImg"></span></span>
            <span class="gen-badge">{d.imgBadge}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  (() => {
    const bar = document.querySelector('[data-tabs="producto"]');
    const panes = document.querySelectorAll('#producto .tab-pane');
    bar?.querySelectorAll('.tab-btn').forEach((b) =>
      b.addEventListener('click', () => {
        bar.querySelectorAll('.tab-btn').forEach((x) => x.setAttribute('aria-selected', 'false'));
        b.setAttribute('aria-selected', 'true');
        const p = b.getAttribute('data-pane');
        panes.forEach((el) => el.classList.toggle('active', el.getAttribute('data-pane') === p));
      })
    );
  })();
  (() => {
    const mock = document.getElementById('ragMock');
    if (!mock) return;
    const scenarios = JSON.parse(mock.getAttribute('data-scenarios') || '[]');
    const thinking = mock.getAttribute('data-thinking') || '…';
    const srcLabel = mock.getAttribute('data-sources-label') || '';
    let idx = 0, timer = null;
    const q = document.getElementById('ragQ');
    const a = document.getElementById('ragA');
    const aText = document.getElementById('ragAText');
    const srcs = document.getElementById('ragSrcs');
    const gen = document.getElementById('ragGen');
    const img = document.getElementById('ragImg');
    const ask = document.getElementById('ragAsk');
    document.querySelectorAll('#ragCols .col').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('#ragCols .col').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        idx = Number(b.getAttribute('data-i'));
        if (q) q.textContent = '“' + scenarios[idx].question + '”';
        if (a) a.hidden = true;
        if (gen) gen.hidden = true;
      })
    );
    ask?.addEventListener('click', () => {
      const s = scenarios[idx];
      if (!s || !a || !aText || !srcs) return;
      if (timer) clearInterval(timer);
      a.hidden = false;
      if (gen) gen.hidden = true;
      srcs.innerHTML = '';
      aText.textContent = thinking;
      const full = s.answer;
      let i = 0;
      setTimeout(() => {
        timer = setInterval(() => {
          i += 3;
          aText.textContent = full.slice(0, i);
          if (i >= full.length) {
            clearInterval(timer);
            srcs.innerHTML = s.sources.map((x) => '<span class="src">◈ ' + x + '</span>').join('') +
              '<span class="src sim">' + s.sim + ' · ' + srcLabel + '</span>';
            if (gen && img) { img.textContent = '“' + s.img + '”'; gen.hidden = false; }
          }
        }, 18);
      }, 550);
    });
  })();
</script>
<style>
  .tab-pane { padding-top: 30px; text-align: center; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: left; margin-top: 10px; }
  .card { padding: 26px; }
  .icon { font-size: 1.7rem; margin-bottom: 12px; }
  .card h3 { font-size: 1.05rem; margin-bottom: 8px; }
  .card p { color: var(--lm-text-muted); font-size: 0.9rem; margin: 0; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: left; }
  .step { padding: 28px; }
  .step .n { font-family: var(--lm-font-head); font-size: 2.1rem; color: transparent; -webkit-text-stroke: 1px var(--lm-accent); }
  .step h3 { margin: 8px 0; font-size: 1.05rem; }
  .step p { color: var(--lm-text-muted); font-size: 0.9rem; margin: 0 0 14px; }
  .term { margin-top: 16px; text-align: left; padding: 22px 26px; background: #050510; }
  .term-t { font-family: var(--lm-font-head); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--lm-accent); margin: 0 0 10px; }
  .term pre { margin: 0; font-family: ui-monospace, monospace; font-size: 0.82rem; line-height: 1.9; color: var(--lm-gold-light); white-space: pre-wrap; }
  .mock { overflow: hidden; text-align: left; box-shadow: var(--lm-shadow); max-width: 920px; margin: 0 auto; }
  .bar { display: flex; align-items: center; gap: 7px; padding: 13px 18px; border-bottom: 1px solid var(--lm-border); background: rgba(0,0,0,.25); }
  .bar span { width: 11px; height: 11px; border-radius: 50%; background: #3a3350; }
  .bar span:first-child { background: #b83232; } .bar span:nth-child(2) { background: #c9a227; } .bar span:nth-child(3) { background: #2e7d52; }
  .bar em { margin-left: 10px; font-style: normal; font-size: 0.76rem; color: var(--lm-text-muted); font-family: ui-monospace, monospace; }
  .body { display: grid; grid-template-columns: 250px 1fr; min-height: 320px; }
  .side { border-right: 1px solid var(--lm-border); padding: 20px; background: rgba(0,0,0,.18); }
  .side-t { font-size: 0.66rem; letter-spacing: 0.18em; color: var(--lm-text-muted); margin: 14px 0 10px; }
  .side-t:first-child { margin-top: 0; }
  .cols { display: grid; gap: 8px; }
  .col { font-size: 0.83rem; text-align: left; background: rgba(255,255,255,.04); color: var(--lm-text-muted); border: 1px solid transparent; border-radius: 8px; padding: 9px 12px; cursor: pointer; font-family: inherit; }
  .col.active { border-color: var(--lm-border-accent); color: var(--lm-text); background: var(--lm-accent-glow); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips span { font-size: 0.72rem; background: #241d3d; border: 1px solid var(--lm-border); border-radius: 999px; padding: 3px 11px; color: var(--lm-gold-light); }
  .stage { padding: 24px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .q { background: rgba(157,111,232,.12); border: 1px solid var(--lm-border-accent); border-radius: 12px; padding: 12px 16px; font-size: 0.9rem; align-self: flex-end; font-style: italic; }
  .a { background: rgba(157,111,232,.06); border: 1px solid var(--lm-border); border-radius: 12px; padding: 14px 16px; font-size: 0.9rem; min-height: 90px; width: 100%; }
  .a b { color: var(--lm-accent); }
  .srcs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .src { font-size: 0.7rem; font-family: ui-monospace, monospace; background: rgba(46,125,82,.14); color: #4db87a; border-radius: 6px; padding: 2px 8px; }
  .src.sim { background: rgba(157,111,232,.14); color: var(--lm-gold-light); }
  .gen { border: 1px dashed var(--lm-border-accent); border-radius: 12px; padding: 22px 18px; width: 100%; background: radial-gradient(circle at 30% 20%, rgba(157,111,232,.22), transparent 60%), radial-gradient(circle at 75% 70%, rgba(157,111,232,.12), transparent 55%), #0b0817; display: flex; flex-direction: column; gap: 10px; }
  .gen-t { font-family: var(--lm-font-head); color: var(--lm-text); font-size: 0.92rem; }
  .gen-badge { align-self: flex-start; font-size: 0.7rem; background: var(--lm-accent); color: #09090f; font-weight: 700; border-radius: 999px; padding: 3px 12px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } .steps { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .body { grid-template-columns: 1fr; } .side { border-right: none; border-bottom: 1px solid var(--lm-border); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
