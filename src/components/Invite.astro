---
import type { Dict } from '../i18n/translations';
import { INVITE_EMAIL, WEB3FORMS_KEY, DEMO_URL, GITHUB_URL } from '../site';

interface Props { t: Dict; }
const { t } = Astro.props;
const v = t.invite;
const mailtoHref = `mailto:${INVITE_EMAIL}?subject=${encodeURIComponent(v.subject)}`;
---
<section class="section wrap" id="invite">
  <p class="kicker reveal">{v.kicker}</p>
  <h2 class="reveal">{v.titleA} <span class="hl">{v.titleB}</span></h2>
  <p class="lede reveal">{v.lede}</p>

  <div class="panel lm-card reveal">
    <form class="form" id="inviteForm" data-web3key={WEB3FORMS_KEY} data-subject={v.subject} data-required={v.required} data-error={v.error} data-sending={v.sending} novalidate>
      <div class="row2">
        <label>{v.name}
          <input class="lm-input" type="text" name="name" placeholder={v.namePh} required autocomplete="name" />
        </label>
        <label>{v.email}
          <input class="lm-input" type="email" name="email" placeholder={v.emailPh} required autocomplete="email" />
        </label>
      </div>
      <label>{v.profile}
        <select class="lm-input" name="profile">
          {v.profileOpts.map((o) => <option>{o}</option>)}
        </select>
      </label>
      <label>{v.message}
        <textarea class="lm-input" name="message" rows={4} placeholder={v.messagePh} required></textarea>
      </label>
      <input type="text" name="botcheck" hidden tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none !important" />
      <p class="err" id="inviteErr" hidden>{v.required}</p>
      <button class="btn btn-primary btn-lg" type="submit" id="inviteSubmit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        <span>{v.submit}</span>
      </button>
      <p class="alt">{v.fallback} <a class="linklike" href={mailtoHref}>{v.mailto}</a></p>
    </form>

    <div class="sent" id="inviteSent" hidden>
      <div class="check">✓</div>
      <h3>{v.sentTitle}</h3>
      <p>{v.sentDesc}</p>
      <button class="linklike" id="againBtn">← {v.again}</button>
    </div>

    <aside class="side">
      <p class="side-t">{v.stepsTitle}</p>
      <div class="steps">
        {v.steps.map((s) => (
          <div class="step"><b>{s.t}</b><p>{s.d}</p></div>
        ))}
      </div>
      <p class="status"><span class="dot"></span>{v.statusNote}</p>
      <div class="side-links">
        <a href={DEMO_URL} target="_blank" rel="noopener">{v.demoLink} →</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub →</a>
      </div>
    </aside>
  </div>
</section>
<script is:inline>
  (() => {
    const form = document.getElementById('inviteForm');
    if (!form) return;
    const err = document.getElementById('inviteErr');
    const sent = document.getElementById('inviteSent');
    const submitBtn = document.getElementById('inviteSubmit');
    const key = form.getAttribute('data-web3key') || '';
    const subject = form.getAttribute('data-subject') || '';
    const requiredMsg = form.getAttribute('data-required') || '';
    const errorMsg = form.getAttribute('data-error') || '';
    const sendingLabel = form.getAttribute('data-sending') || '';
    const fail = (msg) => { if (err) { err.textContent = msg; err.hidden = false; } };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = String(fd.get('name') || '').trim();
      const from = String(fd.get('email') || '').trim();
      const profile = String(fd.get('profile') || '');
      const message = String(fd.get('message') || '').trim();
      const ok = name.length > 1 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(from) && message.length > 3;
      if (!ok) { fail(requiredMsg); return; }
      if (!key) { fail(errorMsg); return; }
      if (err) err.hidden = true;
      let original = '';
      if (submitBtn) {
        submitBtn.disabled = true;
        original = submitBtn.innerHTML;
        submitBtn.textContent = sendingLabel;
      }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            subject: subject,
            name: name,
            email: from,
            reply_to: from,
            from_name: name,
            message: message + '\n\n—\n' + name + ' (' + profile + ')\n' + from,
            botcheck: fd.get('botcheck') || '',
          }),
        });
        const data = await res.json();
        if (data && data.success) {
          form.hidden = true;
          if (sent) sent.hidden = false;
        } else {
          fail(errorMsg);
        }
      } catch {
        fail(errorMsg);
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = original; }
      }
    });
    document.getElementById('againBtn')?.addEventListener('click', () => {
      if (sent) sent.hidden = true;
      form.hidden = false;
      form.reset();
    });
  })();
</script>
<style>
  .panel { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 34px; text-align: left; padding: 40px; margin-top: 26px; max-width: 960px; margin-left: auto; margin-right: auto; }
  .form { display: grid; gap: 16px; align-content: start; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { display: grid; gap: 7px; font-family: var(--lm-font-head); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--lm-text-muted); }
  .lm-input {
    background: var(--lm-raised); border: 1px solid var(--lm-border); color: var(--lm-text);
    border-radius: var(--lm-radius); padding: 0.65rem 0.9rem; font-family: var(--lm-font-body);
    font-size: 0.92rem; width: 100%; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .lm-input:focus { outline: none; border-color: var(--lm-border-accent); box-shadow: 0 0 0 3px var(--lm-accent-glow); }
  .lm-input::placeholder { color: var(--lm-text-dim); }
  select.lm-input option { background: #141424; }
  textarea.lm-input { resize: vertical; min-height: 110px; }
  .err { color: #e0655f; font-size: 0.83rem; margin: 0; }
  .alt { color: var(--lm-text-muted); font-size: 0.83rem; margin: 0; }
  .linklike { background: none; border: none; padding: 0; color: var(--lm-accent); cursor: pointer; font: inherit; text-decoration: underline; }
  a.linklike { text-decoration: underline; }
  .sent { text-align: center; align-self: center; display: grid; gap: 12px; justify-items: center; }
  .sent[hidden] { display: none; }
  .check {
    width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; color: #09090f; background: var(--lm-accent);
  }
  .sent h3 { font-size: 1.3rem; margin: 0; }
  .sent p { color: var(--lm-text-muted); font-size: 0.9rem; margin: 0; }
  .side { border-left: 1px solid var(--lm-border); padding-left: 34px; display: flex; flex-direction: column; gap: 16px; }
  .side-t { font-family: var(--lm-font-head); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--lm-accent); margin: 0; }
  .steps { display: grid; gap: 12px; }
  .step b { font-size: 0.9rem; color: var(--lm-text); }
  .step p { color: var(--lm-text-muted); font-size: 0.85rem; margin: 4px 0 0; }
  .status { display: flex; gap: 9px; align-items: flex-start; font-size: 0.8rem; color: var(--lm-text-muted); margin: 0; background: var(--lm-accent-glow); border: 1px solid var(--lm-border-accent); border-radius: 8px; padding: 10px 14px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #c9a227; margin-top: 6px; flex-shrink: 0; }
  .side-links { display: flex; gap: 16px; font-size: 0.85rem; }
  @media (max-width: 860px) {
    .panel { grid-template-columns: 1fr; padding: 28px; }
    .side { border-left: none; border-top: 1px solid var(--lm-border); padding-left: 0; padding-top: 24px; }
    .row2 { grid-template-columns: 1fr; }
  }
</style>
